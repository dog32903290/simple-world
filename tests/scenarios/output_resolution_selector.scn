# output_resolution_selector.scn — S1-ui live tooth: the Output window's resolution selector
# (TiXL ResolutionHandling.DrawSelector, OutputWindow.cs:316) writes the cook-core frame override
# (RequestedResolution seed, hook landed 1b53b12). Fill = the LIVE Output-window content region
# (S1-fill window-follow; TiXL ResolutionHandling.cs:120/124-127 + OutputWindow.cs:411-414); a
# preset retargets the render. This scenario drives the combo by hand and asserts the COOKED
# preview dims actually change — coupling the assertion to the real cook, not to the UI label.
#
# TWO faces are tested here:
#   1. DEFAULT PREVIEW PATH (first block): the default doc's DrawPoints#7 Command terminal renders into
#      the preview `target` (NO RenderTarget node → NO displayTex). After the seedFrameResolution fix
#      (point_graph_debug.cpp) this `target` sizes to the EFFECTIVE resolution, so a fixed preset
#      retargets the DEFAULT preview — the exact path the shipped bug broke and the RenderTarget leg
#      below could not reach (a RenderTarget's OWN displayTex always adopted the override, masking it).
#   2. RENDERTARGET TERMINAL (second block): a RenderTarget with Resolution=WindowFollow ADOPTS the
#      active RequestedResolution into its OWN texture (displayTex). We build DrawPoints#7 ->
#      RenderTarget#104 to prove the displayTex path retargets too. Both faces now agree.
#
# The Fill dims 307x194 = the Output window's content region in the default DOCK layout (Output is a
# tab in the lower-right stack, ui/layout_dock; io.IniFilename = nullptr so every launch is the same
# default layout — deterministic, re-measured stable across runs). Was 246x230 at right-ratio 0.240,
# and 380x377 further back when Output floated at its old FirstUseEver 380x420. Bumped to 307x194 when
# the narrow-dock toolbar-clip fix widened `right` to 0.300 AND wrapped the Output toolbar onto a
# second row (Snapshot/background now wrap under Pin/Fit/1:1 at this window width, costing the
# viewport one row of height). If the dock partition ratios (ui/layout_dock.cpp, 柏為可調) OR the
# toolbar wrap point change, these numbers change WITH them: re-measure with a probe (sw_drive state
# → .preview) and update both.
#
# RED proofs (assertions couple to actual cooked dims, not luck):
#   - assert the WRONG dims (e.g. assert 1280x720 after picking 1080p) -> RED.
#   - break the selector's setOutputResolutionOverride wiring -> preview stays window-sized after
#     the 1080p pick -> the .preview.w==1920 assert goes RED.
#   - break Fill's clearOutputResolutionOverride -> preview stays 1920x1080 after the Fill pick ->
#     the return-to-window assert goes RED (this is the lifetime leak the writer must prevent).
#   - freeze the window-follow push (drop pushFillWindowSize) -> Fill resolves to the ctor 512x512
#     again -> BOTH 307x194 asserts go RED (the S1-fill live tooth; selftest-window-follow is the
#     headless twin).

# --- the selector toolbar item exists (eye::recordRect output_resolution_combo) ---
assert_map_has output_resolution_combo
echo resolution-combo-present

# ══ FACE 1 — DEFAULT PREVIEW PATH (the face the RenderTarget leg below MISSED) ══════════════════════
# The default doc's terminal is DrawPoints#7 — a Command op rendering into the window-sized preview
# `target` (NO RenderTarget, NO displayTex). Pick 1080p on THIS default doc (no node setup — the doc is
# as-launched) and assert the default preview retargets to 1920x1080. This is the exact surface the
# shipped bug left window-sized; only the seedFrameResolution fix makes it retarget. Headless twin:
# --selftest-preview-target-preset (its injectBug proves the RED face).
do click @output_resolution_combo
wait 0.4
do click @output_res_row:6
wait 0.6
assert_state '.preview.w == 1920 and .preview.h == 1080'
echo default-command-preview-retargets-to-1920x1080

# return to Fill so FACE 2 starts from the window-follow baseline (also proves the override clears on
# the default preview path, not just the RenderTarget one).
do click @output_resolution_combo
wait 0.4
do click @output_res_row:0
wait 0.6
assert_state '.preview.w == 307 and .preview.h == 194'
echo default-preview-clears-back-to-window-region
# ═══════════════════════════════════════════════════════════════════════════════════════════════════

# ══ FACE 2 — RENDERTARGET TERMINAL (displayTex adopts the override) ═════════════════════════════════
# --- build a RenderTarget terminal so the override is observable in cooked dims ---
# Add RenderTarget on the blank canvas (same clear region blur_chain.scn uses).
do rclick 250 240
wait 0.4
assert_map_has ctx:add_node_bg
do click @ctx:add_node_bg
wait 0.4
do click @bgctx:add:RenderTarget
wait 0.5
assert_state '[.lib.symbols[].children[] | select(.id == 104)] | length == 1'
echo rendertarget-104-spawned

# Wire DrawPoints#7.out[pin 702] -> RenderTarget#104.command[pin 10401]. RT#104's output is
# unconsumed, so defaultDrawTarget picks it as the tex-sink terminal.
do drag @pin:702 @pin:10401
wait 0.4
assert_state '[.lib.symbols[] | select(.id == "Root") | .connections[]] | length == 4'
echo drawpoints-into-rendertarget-wired

# --- Fill baseline: the RT terminal follows the LIVE window content region (S1-fill window-follow;
# 307x194 = the default-layout region, see header). NOT the ctor 512x512 — that constant resolving
# here again is exactly the regression this assert bites. ---
wait 0.4
assert_state '.preview.w == 307 and .preview.h == 194'
echo fill-baseline-follows-window-region

# --- drive the selector to 1080p. Each open preset row carries a '#'-free named rect
# output_res_row:<table-index> (Fill=0, 1:1=1, 16:9=2, 4:3=3, 480p=4, 720p=5, 1080p=6, 4k=7,
# 8k=8, 4k Portrait=9). The combo omits scroll-to-selection so row positions are stable. ---
do click @output_resolution_combo
wait 0.4
do click @output_res_row:6
wait 0.6
assert_state '.preview.w == 1920 and .preview.h == 1080'
echo selector-1080p-retargets-to-1920x1080

# --- switch back to Fill (row 0): the override MUST clear and the render returns to the LIVE
# window content region. A leak here (override not cleared) keeps the render at 1920x1080 -> RED. ---
do click @output_resolution_combo
wait 0.4
do click @output_res_row:0
wait 0.6
assert_state '.preview.w == 307 and .preview.h == 194'
echo fill-clears-override-back-to-window-region
